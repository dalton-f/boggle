@import "tailwindcss";

@theme {
  --breakpoint-xs: 23.4375rem;

  --animate-correct-flash: correctFlash 300ms ease;

  @keyframes correctFlash {
    0% {
      background: #4caf50;
      transform: scale(1);
    }

    50% {
      background: #81c784;
      transform: scale(1.15);
    }

    100% {
      background: #4caf50;
      transform: scale(1);
    }
  }
}
